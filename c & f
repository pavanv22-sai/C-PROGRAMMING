celsius to farhenheit

#include<stdio.h>
int main()
{
    int c;
    float f;
    printf("Enter the temp in celsius :");
    scanf("%d",&c);
    
    f=(c*1.8)+32;
    printf("The temp in farenheit : %.2f",f);
}



farhenheit to celsius
#include<stdio.h>
